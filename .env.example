# Copy this file to .env and fill it in. Keep comments on their own lines.

# ===================================================================== Company & security
COMPANY_NAME=Switz Group
# Leave both blank and the app creates random keys once and keeps them in instance/.
# Or generate your own with:  flask --app app gen-secrets
SECRET_KEY=
# Set ID_HASH_KEY once, BEFORE candidates register, and never change it (old PAN/passport IDs would stop matching).
ID_HASH_KEY=

# ===================================================================== Running the app
# python app.py  starts the production server (waitress). HOST=0.0.0.0 lets colleagues on the same
# network open it; HOST=127.0.0.1 keeps it on this PC only.
HOST=0.0.0.0
PORT=5000
# The address people use to open the app; used in staff links and emails.
# Blank = this PC's network address (fine for the POC). Once hosted, e.g. https://careers.yourcompany.com
APP_BASE_URL=
# Minutes a page's form stays valid after it is opened (security). 0 = until sign-out.
FORM_EXPIRY_MINUTES=480

# ===================================================================== AI (LangChain + Hugging Face)
# Pick ONE setup. Switching later only changes these lines.
#
# A) Free model running on this PC (current POC setup). pip install -r requirements-local.txt
LLM_PROVIDER=huggingface_local
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# auto = GPU if available, else CPU | -1 = CPU | 0 = first NVIDIA GPU
HF_LOCAL_DEVICE=auto
# Embeddings for semantic JD <-> resume similarity, also on this PC
EMBEDDINGS_PROVIDER=huggingface_local
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
#
# B) Hugging Face hosted API (needs inference credits on the account)
# LLM_PROVIDER=huggingface
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# HF_INFERENCE_PROVIDER=auto
# EMBEDDINGS_PROVIDER=huggingface
#
# C) Paid models (install the matching langchain-* package)
# LLM_PROVIDER=openai        LLM_MODEL=gpt-4.1-mini        OPENAI_API_KEY=...
# LLM_PROVIDER=anthropic     LLM_MODEL=claude-sonnet-4-5   ANTHROPIC_API_KEY=...
# LLM_PROVIDER=google_genai  LLM_MODEL=gemini-2.5-flash    GOOGLE_API_KEY=...
#
# D) No AI: LLM_PROVIDER=none  (template JDs + keyword screening)

# Hugging Face token (https://huggingface.co/settings/tokens). Needed for B, and to download gated models.
HUGGINGFACEHUB_API_TOKEN=
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE_JD=0.4
LLM_TEMPERATURE_SCREEN=0.1
LLM_TIMEOUT=120

# LangSmith tracing (optional). When on, prompts and replies, including resume text sent for
# screening, are stored in your LangSmith account. Leave false unless you need to debug the AI.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=talentflow

# ===================================================================== Database
# Blank = SQLite file in instance/. For production use PostgreSQL:
# DATABASE_URL=postgresql://user:pass@host:5432/talentflow
DATABASE_URL=

# First HR admin, created on first start if no HR user exists. Change the password after signing in.
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=HR Admin

# ===================================================================== Screening
# background = candidates submit instantly; resumes are screened by a worker in the background and
# HR posts statuses. inline = screen while the candidate waits (only for testing).
SCREENING_MODE=background
AI_WEIGHT=0.7
DEFAULT_SHORTLIST_THRESHOLD=70
REQUIRE_DIFFERENT_APPROVER=false
MAX_UPLOAD_MB=5

# ===================================================================== Candidate ID & re-apply rule
REAPPLY_COOLDOWN_DAYS=90
# any_job | same_title
REAPPLY_SCOPE=any_job

# ===================================================================== Email (sending job links to staff)
# Staff email domains allowed to receive internal job links, comma-separated (blank = any address)
INTERNAL_EMAIL_DOMAINS=
#
# Choose ONE way to send:
#   smtp  = mailbox username + password. Microsoft 365 needs SMTP AUTH enabled on the mailbox by IT, and
#           Microsoft is switching this off by default for existing tenants at the end of December 2026.
#   graph = Microsoft 365 through Microsoft Graph with OAuth (recommended for Microsoft 365).
#           IT registers an app in Microsoft Entra ID with the Mail.Send application permission.
EMAIL_PROVIDER=smtp
#
# --- smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# From address (blank = SMTP_USER)
SMTP_SENDER=
#
# --- graph
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Mailbox the mail is sent from, e.g. careers@yourcompany.com
GRAPH_SENDER=
